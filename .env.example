# Configure these in the hosting dashboard. This file is documentation only.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:mysql://YOUR_HOST:YOUR_PORT/defaultdb?sslMode=REQUIRED
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
# Choose 12 to 20 characters. This is only used to create a missing admin account.
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
SEED_PRODUCTS=true
